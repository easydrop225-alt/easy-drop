# Copie ce fichier en .env.local et remplis les valeurs réelles.
# Ne jamais committer .env.local (déjà ignoré par git).

# Supabase — Project Settings > API sur supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://rnvpqudjjtfyidowthcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (utilisée pour les liens de partage, ex. parrainage)
NEXT_PUBLIC_SITE_URL=https://easy-drop-kappa.vercel.app

# Notifications push natives (Web Push / VAPID) — clé publique uniquement.
# La clé privée reste côté serveur (secret Supabase Edge Function), jamais ici.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clé service_role Supabase — SERVEUR UNIQUEMENT (jamais de préfixe
# NEXT_PUBLIC_). Récupérable dans Supabase > Project Settings > API >
# "service_role" (secret). Nécessaire pour les actions admin avancées comme
# la réinitialisation de mot de passe d'un commercial.
SUPABASE_SERVICE_ROLE_KEY=

# Valeur secrète de ton choix (ex: une longue chaîne aléatoire), à ajouter
# aussi dans Vercel > Settings > Environment Variables. Protège la route de
# "keep-alive" Supabase (voir app/api/cron/keep-alive) contre les appels
# extérieurs non autorisés.
CRON_SECRET=
